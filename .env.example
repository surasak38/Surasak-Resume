# Password for /admin
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie (openssl rand -base64 32)
AUTH_SECRET=

# Storage. Leave these empty to use data/resume.json (local dev / self-hosted).
# On Vercel: Storage → Marketplace → Upstash Redis, then these are added for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Force a driver: "file" or "redis"
# RESUME_STORAGE=
