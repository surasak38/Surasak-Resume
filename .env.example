# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Handle that the old /en, /th and /admin links redirect to
LEGACY_HANDLE=surasak.jrs

# Secret shared with Supabase (private.app_secrets, name view_key) so only the server can record profile views
VIEW_KEY=
